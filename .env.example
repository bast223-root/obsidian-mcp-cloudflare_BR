# Copy to `.env` and fill in. `npm run setup` reads this file to provision
# R2 + KV resources and produce wrangler.jsonc from wrangler.example.jsonc.
#
# .env and wrangler.jsonc are both gitignored. Only .env.example and
# wrangler.example.jsonc are committed.

# ─── Required ───────────────────────────────────────────────────────────────

# Cloudflare account id. From `npx wrangler whoami` or the right sidebar of
# any zone in the Cloudflare dashboard.
CLOUDFLARE_ACCOUNT_ID=

# Hostname the Worker should serve from, e.g. mcp.example.com. Must be a DNS
# name on a zone in the same Cloudflare account. Wrangler provisions the DNS
# record and custom-domain cert on first deploy. If you don't have a custom
# domain, leave blank and remove the `routes` block from wrangler.example.jsonc
# (the Worker will be served from *.workers.dev instead).
MCP_HOSTNAME=

# R2 bucket name. Globally unique within your Cloudflare account; lowercase
# letters, digits, hyphens; 3–63 chars. `npm run setup` will create this
# bucket if it doesn't exist.
R2_BUCKET_NAME=

# ─── Auto-filled by `npm run setup` ─────────────────────────────────────────

# Leave blank on first run. The setup script creates the OAUTH_KV namespace,
# captures the returned id, and appends it back to this file. Subsequent runs
# reuse the id.
OAUTH_KV_ID=

# ─── Optional (defaults shown) ──────────────────────────────────────────────

# Key prefix inside the R2 bucket where vault files live. Empty means the
# vault sits at the bucket root. MUST match Remotely Save's "Remote Prefix"
# setting exactly, or the MCP will see no notes.
VAULT_PREFIX=

# Path template for daily notes. `{{YYYY-MM-DD}}` is replaced with the date.
DAILY_NOTE_PATH_TEMPLATE=Daily Notes/{{YYYY-MM-DD}}.md

# Base URL of the companion `obsidian-link-resolver` Worker, if you deploy
# that too. When set, every note-returning tool emits a short HTTP permalink
# that 302-redirects into Obsidian. Empty (default) disables permalinks.
# Example: https://o.example.com
PERMALINK_BASE_URL=

# ─── Attachment handling ─────────────────────────────────────────────────────
#
# Attachment behavior is configured by plain wrangler vars (ATTACHMENTS_PATH_MODE,
# ATTACHMENTS_SUBFOLDER, ATTACHMENT_ALLOWED_EXTENSIONS, ATTACHMENT_MAX_BYTES,
# ATTACHMENTS_MOVE_WITH_NOTE, ATTACHMENT_URL_TIMEOUT_MS) with safe defaults baked
# into wrangler.example.jsonc. They do NOT flow through .env — to change them,
# edit the `vars` block in wrangler.example.jsonc and rerun `npm run setup`.
# See the "Attachments" section of README.md for what each does.
#
# SERVICE_BASE_URL (this Worker's own origin, used to build upload links) is also
# a wrangler var; it defaults to https://${MCP_HOSTNAME} in wrangler.example.jsonc.

# ─── Secrets (reference only — NOT read from this file) ──────────────────────
#
# These are Workers secrets, set directly in Cloudflare and never substituted
# from .env or committed. `npm run setup` ignores them. Listed here only so you
# don't forget they exist. Set / rotate each with `wrangler secret put`:
#
#   AUTH_PASSWORD   # required — the OAuth consent password you type to connect
#   UPLOAD_TOKEN    # optional — enables the direct /upload endpoint + upload
#                   #   links (bearer token + HMAC signing key). Unset = disabled.
#
#   npx wrangler secret put AUTH_PASSWORD
#   npx wrangler secret put UPLOAD_TOKEN
